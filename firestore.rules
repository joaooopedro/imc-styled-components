rules_version = '2';

// Regras do Firestore do app de IMC.
// So a colecao historico_imc pode ser lida, criada e apagada.
// Os registros nao podem ser editados depois de salvos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /historico_imc/{id} {
      allow read, delete: if true;
      allow create: if request.resource.data.imc is number
                    && request.resource.data.data is string;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
